        <script>
          /* Lazy Calendly loader for every .es-sched booker on the page. Printed once,
             run after DOMContentLoaded so a second scheduler further down is found too.
             See section-scheduler.php for why it is lazy and why there are two
             triggers. */
          (function () {
            function init() {
              var widgets = document.querySelectorAll('.es-sched .calendly-inline-widget');
              if (!widgets.length) return;

              var loaded = false;

              function load() {
                if (loaded) return;
                loaded = true;
                window.removeEventListener('scroll', check);
                window.removeEventListener('resize', check);

                var script = document.createElement('script');
                script.src = 'https://assets.calendly.com/assets/external/widget.js';
                script.async = true;
                script.onerror = function () {
                  Array.prototype.forEach.call(widgets, function (w) {
                    var fallback = w.parentNode.querySelector('.es-sched__fallback[hidden]');
                    if (!fallback) return;
                    w.hidden = true;
                    fallback.hidden = false;
                  });
                };
                document.body.appendChild(script);
              }

              function near(w) {
                var r = w.getBoundingClientRect();
                return r.top - window.innerHeight < 600 && r.bottom > -600;
              }

              function check() {
                if (Array.prototype.some.call(widgets, near)) load();
              }

              if ('IntersectionObserver' in window) {
                var io = new IntersectionObserver(function (entries) {
                  if (entries.some(function (e) { return e.isIntersecting; })) {
                    io.disconnect();
                    load();
                  }
                }, { rootMargin: '600px 0px' });
                Array.prototype.forEach.call(widgets, function (w) { io.observe(w); });
              }

              window.addEventListener('scroll', check, { passive: true });
              window.addEventListener('resize', check, { passive: true });
              check();
            }

            if (document.readyState === 'loading') {
              document.addEventListener('DOMContentLoaded', init);
            } else {
              init();
            }
          })();
        </script>

