  <!-- ==========================================
     14. PRODUCT LAUNCH MODAL (#varn-launch-modal)
     ========================================== -->
  <div class="varn-modal" id="varn-launch-modal" hidden aria-hidden="true">
    <div class="varn-modal__backdrop" data-varn-close></div>

    <div class="varn-modal__dialog" role="dialog" aria-labelledby="varn-modal-title" aria-describedby="varn-modal-desc">

      <button type="button" class="varn-modal__close" data-varn-close aria-label="Close">
        <svg class="varn-modal__close-icon" data-icon="close" width="20" height="20" viewBox="0 0 24 24" fill="none"
          xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
          <path d="M5.6 5.6 18.4 18.4M18.4 5.6 5.6 18.4" fill="none" stroke="currentColor" stroke-width="1.9"
            stroke-linecap="round" />
        </svg> </button>

      <div class="varn-modal__visual" aria-hidden="true">
        <img class="varn-modal__logo" src="images/Varn_logo.svg" alt="" width="230" height="93" loading="lazy"
          decoding="async">
        <span class="varn-modal__rating">Shopify App Store</span>
      </div>

      <div class="varn-modal__body">
        <p class="varn-modal__eyebrow"><span class="varn-modal__live" aria-hidden="true"></span>Now live</p>
        <h2 class="varn-modal__title" id="varn-modal-title">Meet <span>Varn</span></h2>
        <p class="varn-modal__kind">Variants &amp; Swatches for Shopify</p>

        <p class="varn-modal__desc" id="varn-modal-desc">
          The colour swatches, size grids and combined options your product
          pages deserve. Now on the App Store.
        </p>

        <div class="varn-modal__actions">
          <a class="varn-modal__cta" href="javascript:;" target="_blank" rel="noopener" data-varn-cta>
            <span class="varn-modal__cta-label">View on the App Store</span>
            <svg class="varn-modal__cta-icon" data-icon="arrow-right" width="16" height="14" viewBox="0 0 16 14"
              fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
              <path d="M9 1l5 6-5 6M14 7H1" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                stroke-linejoin="round" fill="none" />
            </svg> <span class="es-sr-only"> (opens in a new tab)</span>
          </a>
        </div>
      </div>
    </div>

