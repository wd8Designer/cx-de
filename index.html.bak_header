  <title>Cypherox | eCommerce & Conversion-First Digital Solutions</title>
  <meta name="description"
    content="Custom eCommerce store builds, conversion rate optimization, and full-stack software development built for scale and high performance.">

  <!-- Core Fonts & Design Tokens -->
