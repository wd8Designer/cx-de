      <div class="es-curtain-spacer" id="es-curtain-spacer" aria-hidden="true"></div>
      <section class="es-curtain" id="es-curtain" data-active="0" aria-roledescription="carousel"
        aria-label="Enstacked, Varn and Caffenza">
        <div class="band">
          <canvas id="es-curtain-burn" aria-hidden="true"></canvas>
          <div class="grid">

            <div class="stack">
              <div class="pane lead on" id="es-curtain-p0" role="tabpanel" aria-labelledby="es-curtain-t0">
                <p class="eyebrow">Shopify and eCommerce experts</p>
                <p class="title">We grow eCommerce brands, <span class="hot">conversion-first</span></p>
                <p class="lede">Services and products for Shopify brands, and for the agencies that build them.</p>
                <div class="actions">
                  <a class="btn btn-a" href="javascript:;">Hire Developers</a>
                </div>
              </div>
              <div class="pane lead" id="es-curtain-p1" role="tabpanel" aria-labelledby="es-curtain-t1"
                aria-hidden="true" inert>
                <p class="eyebrow">New Shopify app &middot; Varn</p>
                <p class="title">Every variant, <span class="hot">in living color.</span></p>
                <p class="lede">Varn reads your option names in ten languages, matches them to your product photos and
                  sets up your theme's swatches. It only fills in what it's confident about.</p>
                <div class="actions">
                  <a class="btn btn-a" href="javascript:;" target="_blank" rel="noopener noreferrer">Install Varn
                    free</a>
                  <a class="btn btn-b" href="javascript:;"><i>&rarr;</i> See how Varn works</a>
                </div>
              </div>
              <div class="pane lead" id="es-curtain-p2" role="tabpanel" aria-labelledby="es-curtain-t2"
                aria-hidden="true" inert>
                <p class="eyebrow">Coming soon &middot; Shopify theme</p>
                <p class="title">A Shopify theme for food brands, <span class="hot">coming soon.</span></p>
                <p class="lede">We're packing what we've learned building client stores into a theme you can install
                  yourself.</p>
                <div class="actions">
                  <a class="btn btn-a" href="javascript:;">Get launch updates</a>
                  <a class="btn btn-b" href="javascript:;"><i>&rarr;</i> See stores we've built</a>
                </div>
              </div>
            </div>

            <div class="slot" id="es-curtain-slot" role="img" aria-label="Enstacked logo"></div>

            <div class="stack pointsWrap">
              <ul class="pane points on" data-for="0">
                <li>Build stores that convert</li>
                <li>Optimize what is already live</li>
                <li>Outsource the whole backlog</li>
              </ul>
              <ul class="pane points" data-for="1" aria-hidden="true" inert>
                <li>Zero theme files edited</li>
                <li>Under 10 KB</li>
                <li>Starter plan free forever</li>
              </ul>
              <ul class="pane points" data-for="2" aria-hidden="true" inert>
                <li>Made by the Enstacked team</li>
                <li>Built for food and drink stores</li>
                <li>Install and run it yourself</li>
              </ul>
            </div>

          </div>
