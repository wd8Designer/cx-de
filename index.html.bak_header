        <!-- ==========================================
     12. FREQUENTLY ASKED QUESTIONS (#faq)
     ========================================== -->
        <section class="rv-section rv-bg-white" id="faq">

          <div class="container">

            <div class="rv-faq-grid">

              <div class="rv-faq-aside reveal-up">

                <div class="rv-section-head es-section-head--flush">

                  <p class="rv-eyebrow">FAQs</p>

                  <h2>Frequently Asked <span class="rv-hl">Questions</span></h2>

                </div>

                <div class="rv-faq-ask mt-4">

                  <p>Have a question that's not covered here?</p>

                  <a href="javascript:;">Get in touch

                    <svg width="14" height="12" viewBox="0 0 14 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M8 1L13 6M13 6L8 11M13 6H1" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                        stroke-linejoin="round" />
                    </svg>

                  </a>

                </div>

              </div>

              <div class="reveal-up" style="--rv-delay: .1s;">

                <div class="accordion" id="accordionHomeFAQ">

                  <div class="accordion-item">

                    <h3 class="accordion-header" id="faqHeading1">

                      <button class="accordion-button" type="button" data-bs-toggle="collapse"
                        data-bs-target="#faqCollapse1" aria-expanded="true" aria-controls="faqCollapse1">

                        How quickly can we get started?

                      </button>

                    </h3>

                    <div id="faqCollapse1" class="accordion-collapse collapse show" aria-labelledby="faqHeading1"
                      data-bs-parent="#accordionHomeFAQ">

                      <div class="accordion-body">

                        Most projects kick off within a week. Book a call, and we'll scope it out together.

                      </div>

                    </div>

                  </div>

                  <div class="accordion-item">

                    <h3 class="accordion-header" id="faqHeading2">

                      <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                        data-bs-target="#faqCollapse2" aria-expanded="false" aria-controls="faqCollapse2">

                        What does a typical engagement look like?

                      </button>

                    </h3>

                    <div id="faqCollapse2" class="accordion-collapse collapse" aria-labelledby="faqHeading2"
                      data-bs-parent="#accordionHomeFAQ">

                      <div class="accordion-body">

                        It depends on what you need: project-based, retainer, or dedicated resource. We'll recommend the
                        right model.

                      </div>

                    </div>

                  </div>

                  <div class="accordion-item">

                    <h3 class="accordion-header" id="faqHeading3">

                      <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                        data-bs-target="#faqCollapse3" aria-expanded="false" aria-controls="faqCollapse3">

                        What's your pricing like?

                      </button>

                    </h3>

                    <div id="faqCollapse3" class="accordion-collapse collapse" aria-labelledby="faqHeading3"
                      data-bs-parent="#accordionHomeFAQ">

                      <div class="accordion-body">

                        It varies by scope. Get in touch with us, and we'll give you a clear picture - no vague
                        estimates.

                      </div>

                    </div>

                  </div>

                  <div class="accordion-item">

                    <h3 class="accordion-header" id="faqHeading4">

                      <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                        data-bs-target="#faqCollapse4" aria-expanded="false" aria-controls="faqCollapse4">

                        How long does it take to build a custom Shopify store?

                      </button>

                    </h3>

                    <div id="faqCollapse4" class="accordion-collapse collapse" aria-labelledby="faqHeading4"
                      data-bs-parent="#accordionHomeFAQ">

                      <div class="accordion-body">

                        Most custom builds take 4–8 weeks. Smaller projects or theme customizations can take 1–2 weeks.

                      </div>

                    </div>

                  </div>

                  <div class="accordion-item">

                    <h3 class="accordion-header" id="faqHeading5">

                      <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                        data-bs-target="#faqCollapse5" aria-expanded="false" aria-controls="faqCollapse5">

                        Should I migrate from WooCommerce to Shopify?

                      </button>

                    </h3>

                    <div id="faqCollapse5" class="accordion-collapse collapse" aria-labelledby="faqHeading5"
                      data-bs-parent="#accordionHomeFAQ">

                      <div class="accordion-body">

                        If you're dealing with slow load times, plugin conflicts, or scaling issues, yes. Shopify is
                        faster, more secure, and easier to manage at scale. And if you need assistance, we can help
                        ensure a smooth migration.

                      </div>

                    </div>

                  </div>

                  <div class="accordion-item">

                    <h3 class="accordion-header" id="faqHeading6">

                      <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                        data-bs-target="#faqCollapse6" aria-expanded="false" aria-controls="faqCollapse6">

                        What is a Shopify Partner?

                      </button>

                    </h3>

                    <div id="faqCollapse6" class="accordion-collapse collapse" aria-labelledby="faqHeading6"
                      data-bs-parent="#accordionHomeFAQ">

                      <div class="accordion-body">

                        An agency or developer officially vetted by Shopify. It means your store is built to Shopify's
                        standards, not just by someone who's used the platform a few times.

                      </div>

                    </div>

                  </div>

                </div>

              </div>

            </div>

          </div>

        </section>

