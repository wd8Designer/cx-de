        <!-- White-Label -->

        <section class="esn-panel" id="esn-menu-whitelabel" data-panel="whitelabel" data-width="880" role="region"
          aria-label="White-Label" hidden>

          <div class="esn-grid esn-grid--panel">

            <p class="esn-label esn-panel__eyebrow">For agencies</p>

            <div class="esn-lead esn-panel__lead">

              <p class="esn-heading">Your delivery team, under your brand.</p>

              <p class="esn-sub">We build in the background. You ship the work as your own.</p>

            </div>

            <div class="esn-panel__col">

              <p class="esn-label esn-grouplabel esn-panel__collabel">Services</p>

              <ul class="esn-services esn-panel__links">

                <li><a class="esn-service" href="https://enstacked.com/white-label-shopify-services/"><b>White-Label
                      Shopify</b><span>Shopify delivery under your agency name.</span><span class="esn-service__go"
                      aria-hidden="true"><svg class="esn-arrow" data-icon="arrow-right" width="16" height="14"
