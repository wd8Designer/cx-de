        <!-- Products. 1180 wide (owner, 11 Sep 2026: "too much white space"

           between the copy and the cards at full container width). That is

           a ~490px lead column, the 48px gap and the 36rem card column, plus

           the stage's 32px inset each side. 1120 was tried first and broke

           the second proof point's description onto three lines. -->

        <section class="esn-panel" id="esn-menu-products" data-panel="products" data-width="1180" role="region"
          aria-label="Products" hidden>

          <div class="esn-prodpanel">

            <div class="esn-prodpanel__lead">

              <p class="esn-label esn-prodpanel__eyebrow">Products</p>

              <p class="esn-heading esn-prodpanel__heading">Built by Enstacked, <span>on Shopify.</span></p>

              <ul class="esn-prodpoints">

                <li class="esn-prodpoint">

                  <span class="esn-prodpoint__icon"><svg class="esn-prodpoint__glyph" data-icon="box" width="22"
                      height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"
                      focusable="false">
                      <path d="M12 2.8 20 7.2v9.6l-8 4.4-8-4.4V7.2l8-4.4Z" fill="none" stroke="currentColor"
                        stroke-width="1.6" stroke-linejoin="round" />
                      <path d="M4 7.2l8 4.4 8-4.4M12 11.6v9.6" fill="none" stroke="currentColor" stroke-width="1.6"
                        stroke-linejoin="round" />
                    </svg></span>

                  <span class="esn-prodpoint__text"><b>Built in-house</b><span>Shaped by the stores we ship for
                      clients.</span></span>

                </li>

                <li class="esn-prodpoint">

                  <span class="esn-prodpoint__icon"><svg class="esn-prodpoint__glyph" data-icon="cart" width="22"
                      height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"
                      focusable="false">
                      <path d="M2.8 3.6h2.4l2.3 11.2a1.6 1.6 0 0 0 1.6 1.3h8.5a1.6 1.6 0 0 0 1.6-1.2l1.5-6.6H6.3"
                        fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
                        stroke-linejoin="round" />
                      <circle cx="9.6" cy="19.8" r="1.4" fill="none" stroke="currentColor" stroke-width="1.6" />
                      <circle cx="17.2" cy="19.8" r="1.4" fill="none" stroke="currentColor" stroke-width="1.6" />
                    </svg></span>

                  <span class="esn-prodpoint__text"><b>Built for Shopify</b><span>One app and one theme, native to
                      Shopify.</span></span>

                </li>

              </ul>

            </div>

            <ul class="esn-products">

              <li><a class="esn-product esn-product--violet" href="javascript:;"><span class="esn-product__head"><span
                      class="esn-product__tag">Shopify App</span><span class="esn-product__go"><svg class="esn-arrow"
                        data-icon="arrow-right" width="18" height="16" viewBox="0 0 16 14" fill="none"
                        xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                        <path d="M9 1l5 6-5 6M14 7H1" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                          stroke-linejoin="round" fill="none" />
                      </svg></span></span><span class="esn-product__plate esn-product__plate--logo"><img
                      class="esn-product__logo" src="images/Varn_mark.svg" alt="" width="64" height="64" /></span><span
                    class="esn-product__name">Varn</span><span class="esn-product__desc">Advanced variant experience for
                    modern stores.</span></a></li>
              <li><span class="esn-product esn-product--warm is-soon"><span class="esn-product__head"><span
