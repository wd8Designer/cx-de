  <link rel="stylesheet" href="css/curtain.css">
  <link rel="stylesheet" href="css/brand-override.css">
</head>

<body class="home">

  <!-- Header Navigation with Morphing Mega-Menu & Mobile Drawer -->

  <!-- ==========================================
     1. HEADER NAVIGATION & MEGA-MENU STAGE
     ========================================== -->
  <header class="esn-header" data-header>

    <div class="esn-inner">

      <a class="esn-brand" href="/" aria-label="Enstacked home">

        <img class="esn-brand__mark esn-brand__mark--light" src="images/logo.svg" alt="Enstacked" width="140"
          height="45" />

      </a>

      <nav class="esn-nav" aria-label="Primary">

        <ul class="esn-list">

          <li class="esn-item" data-menu="shopify">

            <button type="button" class="esn-trigger" aria-haspopup="true" aria-expanded="false"
              aria-controls="esn-menu-shopify">

              <span>Shopify</span><svg class="esn-caret" data-icon="caret" width="10" height="10" viewBox="0 0 10 10"
                fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                <path d="M1.5 3.5 5 7l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6"
                  stroke-linecap="round" stroke-linejoin="round" />
              </svg> </button>

          </li>

          <li class="esn-item" data-menu="whitelabel">

            <button type="button" class="esn-trigger" aria-haspopup="true" aria-expanded="false"
              aria-controls="esn-menu-whitelabel">

              <span>White-Label</span><svg class="esn-caret" data-icon="caret" width="10" height="10"
                viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                <path d="M1.5 3.5 5 7l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6"
                  stroke-linecap="round" stroke-linejoin="round" />
              </svg> </button>

          </li>

          <li class="esn-item" data-menu="products">

            <button type="button" class="esn-trigger" aria-haspopup="true" aria-expanded="false"
              aria-controls="esn-menu-products">

              <span>Products</span><svg class="esn-caret" data-icon="caret" width="10" height="10" viewBox="0 0 10 10"
                fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                <path d="M1.5 3.5 5 7l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6"
                  stroke-linecap="round" stroke-linejoin="round" />
              </svg> </button>

          </li>

          <li class="esn-item" data-menu="insights">

            <button type="button" class="esn-trigger" aria-haspopup="true" aria-expanded="false"
              aria-controls="esn-menu-insights">

              <span>Insights</span><svg class="esn-caret" data-icon="caret" width="10" height="10" viewBox="0 0 10 10"
                fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                <path d="M1.5 3.5 5 7l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6"
                  stroke-linecap="round" stroke-linejoin="round" />
              </svg> </button>

          </li>

          <li class="esn-item" data-menu="company">

            <button type="button" class="esn-trigger" aria-haspopup="true" aria-expanded="false"
              aria-controls="esn-menu-company">

              <span>Company</span><svg class="esn-caret" data-icon="caret" width="10" height="10" viewBox="0 0 10 10"
                fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                <path d="M1.5 3.5 5 7l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6"
                  stroke-linecap="round" stroke-linejoin="round" />
              </svg> </button>

          </li>

        </ul>

      </nav>

      <div class="esn-actions">

        <a class="esn-cta" href="javascript:;">

          <span>Contact Us</span>

        </a>

        <button type="button" class="esn-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="esn-drawer"
          data-mobile-toggle>

          <span class="esn-bar"></span>

          <span class="esn-bar"></span>

          <span class="esn-bar"></span>

        </button>

      </div>

    </div>

    <!-- ===================  MEGA MENU STAGE  =================== -->

