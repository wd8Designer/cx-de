                    <source
                      srcset="https://enstacked.com/wp-content/uploads/2025/11/nuclia-deployment-options-featured-300x263.webp 300w, https://enstacked.com/wp-content/uploads/2025/11/nuclia-deployment-options-featured-768x673.webp 768w, https://enstacked.com/wp-content/uploads/2025/11/nuclia-deployment-options-featured-1024x897.webp 1024w, https://enstacked.com/wp-content/uploads/2025/11/nuclia-deployment-options-featured-1536x1346.webp 1536w, https://enstacked.com/wp-content/uploads/2025/11/nuclia-deployment-options-featured.webp 1920w"
